QWidget {
    background: #000000;
    color: #eceef2;
    font-family: "Segoe UI";
    font-size: 13px;
}

#Sidebar {
    background: #000000;
    border-right: 1px solid #121212;
}

#Brand {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 1px;
}

#BrandSmall, #Version, #Signature, #Muted, #PageSubtitle, #MetricUnit {
    color: #7f858f;
}

#BrandSmall {
    font-size: 9px;
    font-weight: 600;
}

#Signature {
    color: #b8bcc4;
    font-weight: 600;
}

#Version {
    font-size: 10px;
}

QPushButton {
    background: transparent;
    color: #adb2ba;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 9px 10px;
    text-align: left;
}

QPushButton:hover {
    background: #0b0b0b;
    color: #ffffff;
}

QPushButton:checked {
    background: #0e0e0e;
    border-color: #1b1b1b;
    color: #ffffff;
}

#Primary {
    background: #f0f1f3;
    color: #090909;
    padding: 10px 15px;
    font-weight: 700;
    text-align: center;
    min-width: 130px;
    border-radius: 6px;
}

#Primary:hover {
    background: #ffffff;
}

#Primary:disabled {
    background: #5f6369;
    color: #171717;
}

#PageTitle {
    font-size: 24px;
    font-weight: 650;
}

#PageSubtitle {
    font-size: 12px;
}

#State {
    color: #a8adb6;
    border: 1px solid #1a1a1a;
    background: #070707;
    border-radius: 5px;
    padding: 6px 9px;
    font-size: 10px;
    font-weight: 700;
}

#Panel, #Metric, #DiagnosticSummary, #DiagnosticCard, #DiagnosticAnalysis {
    background: #050505;
    border: 1px solid #161616;
    border-radius: 7px;
}

#SmallTitle, #MetricName, #DiagnosticSummaryTitle, #DiagnosticAnalysisTitle, #DiagnosticCardTitle {
    color: #8a9099;
    font-size: 10px;
    font-weight: 700;
}

#MetricValue {
    font-size: 22px;
    font-weight: 650;
}

#Score {
    font-size: 42px;
    font-weight: 700;
}

#BigValue {
    font-size: 38px;
    font-weight: 650;
}

#Diagnostic {
    color: #d4d7dc;
    line-height: 1.4;
}

#DiagnosticHealth {
    font-size: 19px;
    font-weight: 600;
    color: #eceef2;
}

#DiagnosticScore {
    font-size: 36px;
    font-weight: 700;
}

#DiagnosticCardValue {
    font-size: 19px;
    font-weight: 650;
}

#DiagnosticCardDetail {
    color: #777d87;
    font-size: 10px;
}

#DiagnosticCard[state="good"] {
    border-left: 3px solid #7ea987;
}

#DiagnosticCard[state="fair"] {
    border-left: 3px solid #b5a16d;
}

#DiagnosticCard[state="bad"] {
    border-left: 3px solid #b66f6f;
}

QComboBox {
    background: #030303;
    border: 1px solid #1a1a1a;
    border-radius: 5px;
    padding: 8px 9px;
    min-width: 220px;
}

QComboBox QAbstractItemView {
    background: #050505;
    border: 1px solid #1a1a1a;
    selection-background-color: #101010;
}

QTableWidget {
    background: #040404;
    alternate-background-color: #080808;
    border: 1px solid #161616;
    gridline-color: #111111;
    selection-background-color: #111111;
}

QHeaderView::section {
    background: #090909;
    color: #aeb3bb;
    border: none;
    border-bottom: 1px solid #161616;
    padding: 8px;
    font-weight: 600;
}

QTableWidget::item {
    padding: 6px;
}

#DiagnosticProgress {
    background: #050505;
    border: none;
}

#DiagnosticProgress::chunk {
    background: #d7dade;
}
