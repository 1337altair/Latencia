QWidget {
    background: #101216;
    color: #e7e9ec;
    font-family: "Segoe UI";
    font-size: 13px;
}

#Sidebar {
    background: #0c0e11;
    border-right: 1px solid #24272d;
}

#Brand {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 1px;
}

#BrandSmall, #Version, #Signature, #Muted, #PageSubtitle, #MetricUnit {
    color: #7d828c;
}

#BrandSmall {
    font-size: 9px;
    font-weight: 600;
}

#Signature {
    color: #a7abb2;
    font-weight: 600;
}

#Version {
    font-size: 10px;
}

QPushButton {
    background: transparent;
    color: #a6abb3;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 9px 10px;
    text-align: left;
}

QPushButton:hover {
    background: #171a1f;
    color: #eeeeee;
}

QPushButton:checked {
    background: #1c1f25;
    border-color: #292d34;
    color: #ffffff;
}

#Primary {
    background: #e6e7e9;
    color: #111318;
    padding: 10px 15px;
    font-weight: 700;
    text-align: center;
    min-width: 130px;
}

#Primary:hover {
    background: #ffffff;
}

#Primary:disabled {
    background: #595c62;
    color: #202226;
}

#PageTitle {
    font-size: 24px;
    font-weight: 650;
}

#PageSubtitle {
    font-size: 12px;
}

#State {
    color: #9ea3ab;
    border: 1px solid #2b2f36;
    background: #15181c;
    border-radius: 5px;
    padding: 6px 9px;
    font-size: 10px;
    font-weight: 700;
}

#Panel, #Metric {
    background: #15181c;
    border: 1px solid #292d34;
    border-radius: 7px;
}

#SmallTitle, #MetricName {
    color: #8d929b;
    font-size: 10px;
    font-weight: 700;
}

#MetricValue {
    font-size: 22px;
    font-weight: 650;
}

#Score {
    font-size: 42px;
    font-weight: 700;
}

#BigValue {
    font-size: 38px;
    font-weight: 650;
}

#Diagnostic {
    color: #cfd2d7;
    line-height: 1.4;
}

QComboBox {
    background: #0f1114;
    border: 1px solid #30343b;
    border-radius: 5px;
    padding: 8px 9px;
    min-width: 220px;
}

QComboBox QAbstractItemView {
    background: #15181c;
    border: 1px solid #30343b;
    selection-background-color: #292d34;
}

QTableWidget {
    background: #121519;
    alternate-background-color: #15181c;
    border: 1px solid #292d34;
    gridline-color: #24282e;
    selection-background-color: #252930;
}

QHeaderView::section {
    background: #181b20;
    color: #a8adb5;
    border: none;
    border-bottom: 1px solid #292d34;
    padding: 8px;
    font-weight: 600;
}

QTableWidget::item {
    padding: 6px;
}
